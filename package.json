{
  "name": "bloomway-world-director",
  "private": true,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "verify:example": "tsx scripts/verify-example.ts",
    "verify:examples": "tsx scripts/verify-examples.ts",
    "dev": "npm run dev -w @bloomway/studio",
    "build": "npm run build -w @bloomway/studio",
    "build:pages": "VITE_BASE_PATH=/bloomway-world-director/ npm run build -w @bloomway/studio",
    "record:demo": "node scripts/record-demo.mjs",
    "record:demos": "node scripts/record-demos.mjs",
    "verify:studio-e2e": "node scripts/verify-studio-e2e.mjs",
    "license:audit": "node scripts/license-audit.mjs",
    "i18n-check": "node scripts/i18n-check-readme.mjs",
    "capture:screenshots": "node scripts/capture-readme-screenshots.mjs",
    "preview:demos-gif": "bash scripts/preview-demos-gif.sh",
    "build:try-cover": "python3 scripts/build-try-cover.py"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2"
  }
}
